# Client-side (Vite) — exposed in the bundle by design.
# Use your own Supabase project's URL and publishable (anon) key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Server-side secrets are NOT set here — they live in the Supabase dashboard
# (Edge Functions → Secrets). The functions read, among others:
#   LOVABLE_API_KEY        — AI gateway for the ai-deadhead function
#   RESEND_API_KEY         — transactional email
#   ADMIN_REPORT_EMAIL     — recipient for daily/weekly admin reports
#   SUPABASE_SERVICE_ROLE_KEY / SUPABASE_URL — injected by Supabase
# Check each function under supabase/functions/<name>/ for what it reads.
