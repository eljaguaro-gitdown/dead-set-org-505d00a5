<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Dead Set — Privacy Manifest (PrivacyInfo.xcprivacy)
  ====================================================
  Required by Apple as of May 1, 2024 for App Store submission.
  Reference: https://developer.apple.com/documentation/bundleresources/privacy_manifest_files

  Scope of this manifest covers ONLY what is shipped inside the iOS app bundle.
  - Google AdSense is web-only (desktop ≥1280px) and is NOT loaded in the
    native iOS WebView, so no advertising data category is declared.
  - Most backend calls hit our own backend (Lovable Cloud / Supabase). ONE
    third-party processor is bundled: PostHog. `posthog-js` ships in the web
    assets and .init()s inside the WKWebView, posting events to
    VITE_PUBLIC_POSTHOG_HOST directly. identifyUser() in src/hooks/useAuth.ts
    sends email address and display name to it on sign-in, which is why those
    two entries below carry the Analytics purpose as well as Authentication.
  - Session replay, autocapture, heatmaps and surveys are explicitly disabled
    in src/lib/posthog.ts. Exception capture is deliberately left ON, which is
    what the CrashData entry below covers.
  - Still no cross-app tracking: NSPrivacyTracking stays false and
    NSPrivacyTrackingDomains stays empty. PostHog here is first-party product
    analytics, not advertising attribution.

  Keep this file in sync with src/pages/PrivacyPolicy.tsx, the App Store
  Connect "App Privacy" questionnaire, and docs/appstore/metadata.md, which
  records the answers to paste into it. If you add a new SDK, geolocation,
  push notifications, IDFA, or third-party analytics, update ALL THREE — this
  file's "no third-party analytics" claim survived PostHog shipping because
  only the code was reviewed.
-->
<plist version="1.0">
<dict>
  <!-- We do NOT track users across apps/sites owned by other companies. -->
  <key>NSPrivacyTracking</key>
  <false/>

  <!-- No tracking domains shipped in the binary. -->
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <!-- ================================================================
       Data types collected by the app, linked to the user's account.
       Each entry must specify whether it is linked to identity, used
       for tracking (always false for us), and the purposes of use.
       ================================================================ -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array>

    <!-- Email Address — account creation & sign-in, and sent to PostHog by
         identifyUser() to attach analytics events to an account. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeAuthentication</string>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>

    <!-- Name / Handle — display name on profile & shared setlists, and sent
         to PostHog by identifyUser() alongside the email address. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeName</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>

    <!-- User ID — Supabase auth.uid, used to scope all user data via RLS -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeUserID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeAuthentication</string>
      </array>
    </dict>

    <!-- Photos — optional avatar uploads to the avatars storage bucket -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- User-generated content: setlists, comments, chat, DMs, beta feedback -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Customer Support / Feedback — Backstage Inner Circle submissions -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCustomerSupport</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Device ID — ds_visitor_id, a random UUID minted in localStorage on first
         visit and sent as the x-visitor-id header. Not an IDFA or IDFV and never
         used for tracking, but it is persistent and it is joined to a user_id in
         visitor_attribution once someone signs up, so it is declared linked. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeDeviceID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>

    <!-- Product Interaction — plays, favorites, upvotes, presence (analytics) -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeProductInteraction</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>

    <!-- Crash & performance data (Apple-collected via Xcode Organizer) -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCrashData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePerformanceData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
  </array>

  <!-- ================================================================
       Required-Reason APIs.
       Apple requires a documented reason for each of these APIs that
       could be abused for fingerprinting. Capacitor and the WKWebView
       use a few of these under the hood, so we declare the standard
       reasons here.
       Reference: https://developer.apple.com/documentation/bundleresources/privacy_manifest_files/describing_use_of_required_reason_api
       ================================================================ -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <!-- UserDefaults — used by Capacitor Preferences / WKWebView state -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>

    <!-- File timestamp APIs — WKWebView cache management -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>C617.1</string>
      </array>
    </dict>

    <!-- System boot time — used inside WKWebView for relative timestamps -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>35F9.1</string>
      </array>
    </dict>

    <!-- Disk space APIs — WKWebView storage quota checks -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>E174.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
